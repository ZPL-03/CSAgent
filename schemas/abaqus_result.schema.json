{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "csdm_cph/abaqus_result.schema.json",
  "title": "CSDM_cph Abaqus Result Schema",
  "type": "object",
  "required": [
    "candidate_id",
    "status",
    "retry_count"
  ],
  "properties": {
    "candidate_id": {"type": "string"},
    "design_revision_id": {"type": ["string", "null"], "pattern": "^DR_[a-f0-9]{64}$"},
    "parent_design_revision_id": {"type": ["string", "null"], "pattern": "^DR_[a-f0-9]{64}$"},
    "status": {
      "type": "string",
      "enum": ["success", "failed", "max_retries_exceeded"]
    },
    "retry_count": {
      "type": "integer",
      "minimum": 0
    },
    "ultimate_pressure_MPa": {"type": ["number", "null"]},
    "failure_pressure_MPa": {"type": ["number", "null"]},
    "linear_buckling_pressure_MPa": {"type": ["number", "null"]},
    "first_mode_eigenvalue": {"type": ["number", "null"]},
    "postbuckling_pressure_MPa": {"type": ["number", "null"]},
    "geometric_limit_pressure_MPa": {"type": ["number", "null"]},
    "geometric_limit_pressure_observed_MPa": {"type": ["number", "null"]},
    "postbuckling_reference_pressure_MPa": {"type": ["number", "null"]},
    "postbuckling_last_pressure_MPa": {"type": ["number", "null"]},
    "riks_lpf_max": {"type": ["number", "null"]},
    "riks_lpf_last": {"type": ["number", "null"]},
    "riks_time_at_lpf_max": {"type": ["number", "null"]},
    "riks_time_last": {"type": ["number", "null"]},
    "imperfection_amplitude_mm": {"type": ["number", "null"]},
    "ultimate_pressure_basis": {"type": ["string", "null"]},
    "geometric_limit_pressure_basis": {"type": ["string", "null"]},
    "failure_mode": {"type": ["string", "null"]},
    "max_displacement_mm": {"type": ["number", "null"]},
    "weight_kg_per_m2": {"type": ["number", "null"]},
    "verdict": {"type": ["string", "null"]},
    "abaqus_odb": {"type": ["string", "null"]},
    "linear_buckling_odb": {"type": ["string", "null"]},
    "postbuckling_odb": {"type": ["string", "null"]},
    "service_odb": {"type": ["string", "null"]},
    "target_odb": {"type": ["string", "null"]},
    "abaqus_inp": {"type": ["string", "null"]},
    "postbuckling_inp": {"type": ["string", "null"]},
    "service_inp": {"type": ["string", "null"]},
    "target_inp": {"type": ["string", "null"]},
    "visualization_json": {"type": ["string", "null"]},
    "artifact_dir": {"type": ["string", "null"]},
    "error_type": {"type": ["string", "null"]},
    "error_log": {
      "type": ["object", "string", "null"]
    },
    "mode_eigenvalues": {
      "type": ["array", "null"],
      "items": {"type": "number"}
    },
    "load_summary": {"type": ["string", "null"]},
    "boundary_summary": {"type": ["string", "null"]},
    "diagnosis_summary": {"type": ["string", "null"]},
    "analysis_type": {"type": ["string", "null"]},
    "user_subroutine_used": {"type": ["boolean", "null"]},
    "progressive_damage_complete": {"type": ["boolean", "null"]},
    "design_check_status": {"type": ["string", "null"]},
    "design_verdict_basis": {"type": ["string", "null"]},
    "capacity_assessment_status": {"type": ["string", "null"]},
    "runtime_script_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "verification_scope": {"type": ["string", "null"]},
    "abaqus_job_status": {"type": ["string", "null"]},
    "riks_increment_count": {"type": ["integer", "null"], "minimum": 0},
    "riks_limit_point_observed": {"type": ["boolean", "null"]},
    "riks_limit_point_confirmed": {"type": ["boolean", "null"]},
    "riks_post_peak_drop_ratio": {"type": ["number", "null"], "minimum": 0},
    "first_ply_failure_pressure_MPa": {"type": ["number", "null"]},
    "first_ply_failure_criterion": {"type": ["string", "null"]},
    "first_ply_failure_index": {"type": ["number", "null"], "minimum": 0},
    "first_ply_failure_mode": {"type": ["string", "null"]},
    "first_ply_failure_element_label": {"type": ["integer", "null"], "minimum": 0},
    "first_ply_failure_section_point": {"type": ["string", "null"]},
    "first_ply_failure_pressure_lower_bound_MPa": {"type": ["number", "null"]},
    "first_ply_failure_pressure_upper_bound_MPa": {"type": ["number", "null"]},
    "service_abaqus_job_status": {"type": ["string", "null"]},
    "service_failure_criterion": {"type": ["string", "null"]},
    "service_pressure_check_status": {"type": ["string", "null"], "enum": ["passed", "failed", "not_reached", "solver_failed", null]},
    "service_pressure_checked_MPa": {"type": ["number", "null"]},
    "service_hashin_index_max": {"type": ["number", "null"], "minimum": 0},
    "service_hashin_failure_mode": {"type": ["string", "null"]},
    "service_hashin_element_label": {"type": ["integer", "null"], "minimum": 0},
    "service_hashin_section_point": {"type": ["string", "null"]},
    "target_failure_criterion": {"type": ["string", "null"]},
    "target_abaqus_job_status": {"type": ["string", "null"]},
    "target_pressure_check_status": {"type": ["string", "null"], "enum": ["passed", "failed", "not_reached", "solver_failed", null]},
    "target_pressure_checked_MPa": {"type": ["number", "null"]},
    "target_hashin_index_max": {"type": ["number", "null"], "minimum": 0},
    "target_hashin_failure_mode": {"type": ["string", "null"]},
    "target_hashin_element_label": {"type": ["integer", "null"], "minimum": 0},
    "target_hashin_section_point": {"type": ["string", "null"]}
  },
  "additionalProperties": true
}
